ROCQ ?= rocq

.PHONY: all check
all:
	$(MAKE) -f Makefile all
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolCandidate.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolResources.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolExtension.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolRules.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolFraming.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolInterference.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolParallel.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolAdequacy.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedDekkerResources.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedDekkerVerification.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedDekkerProof.v
	$(ROCQ) compile -Q theories WMLR theories/DekkerSyntax.v
	$(ROCQ) compile -Q theories WMLR theories/HeapExtensionFootprint.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedDekkerAdequacy.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolLimitations.v
	$(ROCQ) compile -Q theories WMLR theories/BufferedPoolAudit.v

check: all
	$(ROCQ) check -silent -Q theories WMLR WMLR.Audit WMLR.BufferedPoolAudit
