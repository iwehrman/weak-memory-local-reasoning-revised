# Stage 1 is now in the main build. Candidate definitions stay separate.
.PHONY: check check-daring check-withdrawn
check: check-daring
check-daring:
	$(MAKE) -f Makefile check
	rocq compile -Q theories WMLR theories/BufferedPoolCandidate.v
	rocq check -silent -Q theories WMLR WMLR.BufferedPoolCandidate

# Retain a way to inspect the withdrawn first candidate without including
# it in the default build or counting its propositions as proved rules.
check-withdrawn:
	$(MAKE) -f Makefile check
	rocq compile -Q theories WMLR theories/DaringCandidate.v
	rocq check -silent -Q theories WMLR WMLR.DaringCandidate
